<ui:SHDialogContentBase x:Class="FreeTheLights.UI.WiringDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
                        xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
                        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
                        xmlns:local="clr-namespace:FreeTheLights.UI"
                        Title="LED wiring"
                        MinWidth="760" MinHeight="460">
    <ui:SHDialogContentBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FreeTheLights;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:SHDialogContentBase.Resources>

    <DockPanel Margin="4">
        <!-- Own button row, like the wizard (SimHub's Ok/Cancel bar is hidden). Edits apply at once, like everywhere on the device page. -->
        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Padding="0,14,0,0" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
            <styles:SHButtonPrimary Style="{StaticResource DialogButtonPrimary}" HorizontalAlignment="Right" IsDefault="True" IsCancel="True" Click="Done_Click" ToolTip="Close; your changes are saved">
                <StackPanel Style="{StaticResource ButtonContent}">
                    <icons:PackIconMaterial Style="{StaticResource ButtonIcon}" Kind="Check" />
                    <TextBlock Text="Done" VerticalAlignment="Center" />
                </StackPanel>
            </styles:SHButtonPrimary>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,16">
            <TextBlock x:Name="Heading" Style="{StaticResource Text.Title}" FontSize="19" Margin="0,0,0,4" />
            <TextBlock Style="{StaticResource Text.Hint}" TextWrapping="Wrap"
                       Text="Your device now shows each group in its own color, with a white dot running along it. Change the list until the preview matches your device." />
        </StackPanel>

        <local:WiringEditorView x:Name="Editor" />
    </DockPanel>
</ui:SHDialogContentBase>
