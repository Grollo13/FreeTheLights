<!--
    Shared look of the FreeTheLights settings page and wizard, layered on SimHub's MahApps theme.
    Styles that only adjust a control are BasedOn its implicit SimHub/MahApps style; without that, controls lose
    the theme and render white-on-white. Icons, accents and status dots are set with the attached properties in Ux.cs.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib"
                    xmlns:ui="clr-namespace:FreeTheLights.UI">

    <ui:BoolToVisibilityConverter x:Key="BoolToVisibility" />
    <ui:BoolToOpacityConverter x:Key="BoolToOpacity" />
    <ui:EnumEqualsConverter x:Key="EnumEquals" />
    <ui:EnumDisplayConverter x:Key="EnumDisplay" />
    <ui:FlagOptionConverter x:Key="FlagOptionName" />
    <ui:FlagOptionConverter x:Key="FlagOptionDescription" Description="True" />
    <ui:IntEqualsConverter x:Key="IntEquals" />
    <ui:HexToBrushConverter x:Key="HexToBrush" />
    <ui:LedRangeConverter x:Key="LedRange" />
    <ui:LayerIconConverter x:Key="LayerIcon" />
    <ui:LayerAccentConverter x:Key="LayerAccent" />
    <ui:DeviceIconConverter x:Key="DeviceIcon" />
    <ui:DeviceSummaryConverter x:Key="DeviceSummary" />
    <ui:IndexToRankConverter x:Key="IndexToRank" />
    <ui:WiringColorConverter x:Key="WiringColor" />
    <ui:NullToVisibilityConverter x:Key="NullToVisibility" />
    <ui:SimHubImageConverter x:Key="SimHubImage" />

    <DataTemplate x:Key="EnumItemTemplate">
        <TextBlock Text="{Binding Converter={StaticResource EnumDisplay}}" />
    </DataTemplate>

    <!-- A choice with Name and Description in a drop-down: the name, and the description as a tooltip. -->
    <DataTemplate x:Key="ChoiceTemplate">
        <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
    </DataTemplate>

    <!-- A flag animation in a drop-down: its name, and what it looks like as a tooltip. -->
    <DataTemplate x:Key="FlagOptionTemplate">
        <TextBlock Text="{Binding Converter={StaticResource FlagOptionName}}" ToolTip="{Binding Converter={StaticResource FlagOptionDescription}}" />
    </DataTemplate>

    <!-- ===================== Surfaces ===================== -->
    <SolidColorBrush x:Key="Brush.Card" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="Brush.CardBorder" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="Brush.Row" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="Brush.Selected" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="Brush.Outline" Color="#30FFFFFF" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#1A000000" />

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Card}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18,16" />
        <Setter Property="Margin" Value="0,0,0,14" />
    </Style>

    <!-- A row inside a card: flag rules, LED groups, front plate elements, priority entries. -->
    <Style x:Key="RowCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Brush.Row}" />
        <Setter Property="BorderBrush" Value="{StaticResource Brush.CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="#1FFFFFFF" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontSize" Value="11" />
    </Style>

    <!-- ===================== Text ===================== -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Heading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="Text.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Text.Hint" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Opacity" Value="0.62" />
        <Setter Property="LineHeight" Value="18" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Opacity" Value="0.85" />
    </Style>

    <!-- Device name in the page header: looks like a title, edits like a text box. -->
    <Style x:Key="TitleTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- Element or group name as the inspector's heading: the same, at heading size.
         The negative margin offsets the text box's inner padding, so the text lines up with the subtitle below. -->
    <Style x:Key="HeadingTextBox" TargetType="TextBox" BasedOn="{StaticResource TitleTextBox}">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Margin" Value="-6,0,0,0" />
    </Style>

    <!-- Icon tile: an icon on a tinted rounded square (Ux.Icon, Ux.Accent; Width/Height set the tile size). -->
    <Style x:Key="IconTile" TargetType="ContentControl">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border CornerRadius="9" Opacity="0.18" Background="{TemplateBinding ui:Ux.Accent}" />
                        <icons:PackIconMaterial Width="{TemplateBinding FontSize}" Height="{TemplateBinding FontSize}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                Kind="{TemplateBinding ui:Ux.Icon}"
                                                Foreground="{TemplateBinding ui:Ux.Accent}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FontSize" Value="20" />
    </Style>

    <!-- ===================== Toggle switch ===================== -->
    <Style x:Key="Switch" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="38" Height="20" VerticalAlignment="Center">
                            <Border x:Name="Track" CornerRadius="10" Background="#26FFFFFF" BorderBrush="#40FFFFFF" BorderThickness="1" />
                            <Ellipse x:Name="Thumb" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="#FFB0B0B0" />
                        </Grid>
                        <ContentPresenter x:Name="Label" Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="#80FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource AccentColorBrush}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Fill" Value="White" />
                        </Trigger>
                        <Trigger Property="Content" Value="{x:Null}">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Chips (test inputs, target groups) ===================== -->
    <!-- Checked = highlighted only; nothing is added or made bold, so a chip keeps its width. -->
    <ControlTemplate x:Key="ChipTemplate" TargetType="ToggleButton">
        <Border x:Name="Bd" CornerRadius="15" Padding="{TemplateBinding Padding}" Background="#0AFFFFFF" BorderBrush="{StaticResource Brush.Outline}" BorderThickness="1" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal">
                <icons:PackIconMaterial x:Name="Icon" Width="14" Height="14" Margin="0,0,7,0" VerticalAlignment="Center"
                                        Kind="{TemplateBinding ui:Ux.Icon}"
                                        Foreground="{TemplateBinding ui:Ux.Accent}" />
                <ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True" />
            </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="ui:Ux.Icon" Value="None">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ui:Ux.Accent" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="#50FFFFFF" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorBrush3}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="Chip" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Template" Value="{StaticResource ChipTemplate}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="ChipCheck" TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="Template" Value="{StaticResource ChipTemplate}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- A chip that runs a command instead of toggling (for example "select all buttons"). -->
    <Style x:Key="ChipButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" CornerRadius="15" Padding="{TemplateBinding Padding}" Background="#0AFFFFFF" BorderBrush="{StaticResource Brush.Outline}" BorderThickness="1" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="#50FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Buttons ===================== -->
    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="30" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="Bd" CornerRadius="6" Background="Transparent" />
                        <icons:PackIconMaterial x:Name="Icon" Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.75"
                                                Kind="{TemplateBinding ui:Ux.Icon}"
                                                Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                            <Setter TargetName="Icon" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#3AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Icon" Property="Opacity" Value="0.25" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="IconButton.Danger" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{x:Static ui:Theme.Abs}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Dashed "add something" tile (Ux.Icon, Ux.Accent). -->
    <Style x:Key="AddTile" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="Padding" Value="14,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Rectangle x:Name="Outline" RadiusX="8" RadiusY="8" Stroke="#4DFFFFFF" StrokeThickness="1.2" StrokeDashArray="4 3" Fill="Transparent" />
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}">
                            <icons:PackIconMaterial Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center"
                                                    Kind="{TemplateBinding ui:Ux.Icon}"
                                                    Foreground="{TemplateBinding ui:Ux.Accent}" />
                            <ContentPresenter VerticalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.FontSize="12" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Outline" Property="Fill" Value="{StaticResource Brush.Hover}" />
                            <Setter TargetName="Outline" Property="Stroke" Value="#90FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Outline" Property="Fill" Value="#26FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Dark stage behind the LED previews. -->
    <Style x:Key="Stage" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="18" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="MinHeight" Value="160" />
        <Setter Property="Background">
            <Setter.Value>
                <RadialGradientBrush Center="0.5,0.45" GradientOrigin="0.5,0.45" RadiusX="0.8" RadiusY="0.9">
                    <GradientStop Offset="0" Color="#FF1C1D22" />
                    <GradientStop Offset="1" Color="#FF101013" />
                </RadialGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Text buttons of dialogs and the wizard (Cancel, Back, Next, ...): all as wide and tall as each other. -->
    <sys:Double x:Key="DialogButtonMinWidth">118</sys:Double>
    <Style x:Key="DialogButtonPrimary" TargetType="styles:SHButtonPrimary" BasedOn="{StaticResource {x:Type styles:SHButtonPrimary}}">
        <Setter Property="MinWidth" Value="{StaticResource DialogButtonMinWidth}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="DialogButtonSecondary" TargetType="styles:SHButtonSecondary" BasedOn="{StaticResource {x:Type styles:SHButtonSecondary}}">
        <Setter Property="MinWidth" Value="{StaticResource DialogButtonMinWidth}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Content of a SimHub primary/secondary button: icon + text in a row of fixed height, so buttons with and without an icon are equally tall. -->
    <Style x:Key="ButtonContent" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Height" Value="18" />
    </Style>
    <Style x:Key="ButtonIcon" TargetType="icons:PackIconMaterial">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================== Feature header ===================== -->
    <!-- Header = title, Content = the on/off switch, Ux.Icon / Ux.Accent / Ux.Description. -->
    <Style x:Key="FeatureHeader" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardBorder}" BorderThickness="1" CornerRadius="10" Padding="18,16" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl Style="{StaticResource IconTile}" Width="46" Height="46" FontSize="24" VerticalAlignment="Top"
                                            ui:Ux.Icon="{TemplateBinding ui:Ux.Icon}" ui:Ux.Accent="{TemplateBinding ui:Ux.Accent}" />
                            <StackPanel Grid.Column="1" Margin="16,0,16,0" VerticalAlignment="Center">
                                <ContentPresenter ContentSource="Header" TextElement.FontSize="17" TextElement.FontWeight="SemiBold" />
                                <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Hint}" Text="{TemplateBinding ui:Ux.Description}" />
                            </StackPanel>
                            <ContentPresenter Grid.Column="2" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Navigation tabs ===================== -->
    <Style x:Key="NavTabControl" TargetType="TabControl" BasedOn="{StaticResource {x:Type TabControl}}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,0,0,1" Padding="0,0,0,6" Margin="0,0,0,16">
                            <WrapPanel IsItemsHost="True" />
                        </Border>
                        <ContentPresenter ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tab with Ux.Icon, Ux.Accent (icon color when selected) and Ux.Status (feature on/off dot). -->
    <Style x:Key="NavTab" TargetType="TabItem" BasedOn="{StaticResource {x:Type TabItem}}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,0,4,4">
                        <Border x:Name="Bd" CornerRadius="8" Padding="11,8" Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <icons:PackIconMaterial x:Name="Icon" Width="16" Height="16" VerticalAlignment="Center" Opacity="0.6"
                                                        Kind="{TemplateBinding ui:Ux.Icon}" Foreground="{TemplateBinding Foreground}" />
                                <icons:PackIconMaterial x:Name="AccentIcon" Width="16" Height="16" VerticalAlignment="Center" Visibility="Collapsed"
                                                        Kind="{TemplateBinding ui:Ux.Icon}" Foreground="{TemplateBinding ui:Ux.Accent}" />
                                <ContentPresenter x:Name="Header" ContentSource="Header" Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.75"
                                                  TextElement.FontSize="13" TextElement.FontWeight="Normal" />
                                <Ellipse x:Name="Dot" Width="7" Height="7" Margin="8,1,0,0" VerticalAlignment="Center" Fill="{x:Static ui:Theme.Ok}" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="Underline" Height="2" CornerRadius="1" Margin="10,0" VerticalAlignment="Bottom" Visibility="Hidden"
                                Background="{TemplateBinding ui:Ux.Accent}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="ui:Ux.Status" Value="{x:Null}">
                            <Setter TargetName="Dot" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="ui:Ux.Status" Value="False">
                            <Setter TargetName="Dot" Property="Fill" Value="Transparent" />
                            <Setter TargetName="Dot" Property="Stroke" Value="#70FFFFFF" />
                            <Setter TargetName="Dot" Property="StrokeThickness" Value="1.2" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                            <Setter TargetName="Header" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selected}" />
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="AccentIcon" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Header" Property="Opacity" Value="1" />
                            <Setter TargetName="Header" Property="TextElement.FontWeight" Value="SemiBold" />
                            <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Part switcher (segmented control) ===================== -->
    <Style x:Key="PartSwitchItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" Margin="0,0,6,0" Padding="14,7" CornerRadius="16" Background="#0AFFFFFF" BorderBrush="{StaticResource Brush.Outline}" BorderThickness="1">
                        <ContentPresenter TextElement.FontSize="13" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorBrush3}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Sidebar device list ===================== -->
    <Style x:Key="DeviceListItem" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Margin="0,0,0,4">
                        <Border x:Name="Bd" CornerRadius="9" Padding="10,9" Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" Margin="0,12" HorizontalAlignment="Left" Background="{DynamicResource AccentColorBrush}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Selected}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Brush.CardBorder}" />
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===================== Collapsible card ===================== -->
    <Style x:Key="CardExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardBorder}" BorderThickness="1" CornerRadius="10">
                        <DockPanel>
                            <ToggleButton DockPanel.Dock="Top" Cursor="Hand" Focusable="False"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="14,11">
                                            <DockPanel>
                                                <icons:PackIconMaterial x:Name="Chevron" DockPanel.Dock="Right" Kind="ChevronDown" Width="11" Height="11" Opacity="0.6" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <DockPanel>
                                    <icons:PackIconMaterial DockPanel.Dock="Left" Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Center"
                                                            Kind="{TemplateBinding ui:Ux.Icon}" Foreground="{TemplateBinding ui:Ux.Accent}" />
                                    <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.FontSize="13" />
                                </DockPanel>
                            </ToggleButton>
                            <ContentPresenter x:Name="Body" Margin="14,0,14,14" Visibility="Collapsed" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="Body" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Status dot of the live/car data lines: Tag = "ok", "busy", "warn" or anything else for idle. -->
    <Style x:Key="StatusDot" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{x:Static ui:Theme.Idle}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="ok">
                <Setter Property="Fill" Value="{x:Static ui:Theme.Ok}" />
            </Trigger>
            <Trigger Property="Tag" Value="busy">
                <Setter Property="Fill" Value="{x:Static ui:Theme.Busy}" />
            </Trigger>
            <Trigger Property="Tag" Value="warn">
                <Setter Property="Fill" Value="{x:Static ui:Theme.Warning}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Drag handle of reorderable lists. -->
    <Style x:Key="Grip" TargetType="icons:PackIconMaterial">
        <Setter Property="Kind" Value="DragVertical" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Opacity" Value="0.45" />
        <Setter Property="Margin" Value="2,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Setter Property="ToolTip" Value="Drag to reorder" />
    </Style>

    <!-- Direction of a row, column or matrix (bind IsChecked to Reversed; set Content). -->
    <Style x:Key="WiringDirectionSwitch" TargetType="CheckBox" BasedOn="{StaticResource Switch}">
        <Setter Property="ToolTip" Value="Turn on if the white dot runs the other way than in the preview" />
    </Style>
</ResourceDictionary>
