<UserControl x:Class="FreeTheLights.UI.ColorPickerButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <UserControl.Resources>
        <!-- Round preset swatch with a ring on hover. -->
        <Style x:Key="PresetSwatch" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent">
                            <Ellipse x:Name="Ring" Stroke="Transparent" StrokeThickness="2" />
                            <Ellipse Margin="4" Fill="{TemplateBinding Background}" Stroke="#50FFFFFF" StrokeThickness="1" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="Stroke" Value="#C0FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChannelLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style x:Key="ChannelValue" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ToggleButton x:Name="OpenButton" Width="58" Height="26" ToolTip="Pick a color" Cursor="Hand" Focusable="False"
                      IsChecked="{Binding IsOpen, ElementName=PickerPopup, Mode=TwoWay}">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Frame" CornerRadius="6" BorderBrush="#40FFFFFF" BorderThickness="1" Background="#14FFFFFF" Padding="3">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="#A0FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
            <Grid>
                <Border x:Name="Swatch" CornerRadius="3" />
                <!-- "No color": a dim slash plus a label -->
                <Grid x:Name="NoneLabel" Visibility="Collapsed">
                    <Line X1="0" Y1="1" X2="1" Y2="0" Stretch="Fill" Stroke="#60FF6060" StrokeThickness="1.5" />
                    <TextBlock Text="none" FontSize="10" Opacity="0.75" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </ToggleButton>
        <Popup x:Name="PickerPopup" PlacementTarget="{Binding ElementName=OpenButton}" Placement="Bottom" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True">
            <Border Margin="0,0,12,12" Background="#FF2A2A2E" BorderBrush="#40FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12" TextElement.Foreground="White">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.5" />
                </Border.Effect>
                <StackPanel Width="236">
                    <ItemsControl x:Name="Presets" Margin="-2,0,-2,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource PresetSwatch}" Background="{Binding Brush}" Click="Preset_Click" Tag="{Binding Hex}" ToolTip="{Binding Name}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="30" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Style="{StaticResource ChannelLabel}" Foreground="#FFFF6B6B" Text="R" />
                        <Slider Grid.Row="0" Grid.Column="1" x:Name="RedSlider" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" />
                        <TextBlock Grid.Row="0" Grid.Column="2" Style="{StaticResource ChannelValue}" Text="{Binding Value, ElementName=RedSlider, StringFormat=F0}" />
                        <TextBlock Grid.Row="1" Style="{StaticResource ChannelLabel}" Foreground="#FF6BDB6B" Text="G" />
                        <Slider Grid.Row="1" Grid.Column="1" x:Name="GreenSlider" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" />
                        <TextBlock Grid.Row="1" Grid.Column="2" Style="{StaticResource ChannelValue}" Text="{Binding Value, ElementName=GreenSlider, StringFormat=F0}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource ChannelLabel}" Foreground="#FF6BA6FF" Text="B" />
                        <Slider Grid.Row="2" Grid.Column="1" x:Name="BlueSlider" Minimum="0" Maximum="255" ValueChanged="Slider_ValueChanged" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource ChannelValue}" Text="{Binding Value, ElementName=BlueSlider, StringFormat=F0}" />
                    </Grid>
                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="NoneButton" DockPanel.Dock="Right" Padding="10,3" Click="None_Click" Visibility="Collapsed"
                                Content="No color" ToolTip="Remove the color" />
                        <TextBlock Text="Hex" Opacity="0.7" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBox x:Name="HexBox" Width="100" HorizontalAlignment="Left" LostFocus="HexBox_Commit" KeyDown="HexBox_KeyDown" />
                    </DockPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
