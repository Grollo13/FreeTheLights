<ui:SHDialogContentBase x:Class="FreeTheLights.UI.PhotoLedDialog"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
                        xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
                        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
                        xmlns:local="clr-namespace:FreeTheLights.UI"
                        Title="LED positions on the picture"
                        MinWidth="760" MinHeight="460">
    <ui:SHDialogContentBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FreeTheLights;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </ui:SHDialogContentBase.Resources>

    <DockPanel Margin="4">
        <!-- Own button row, like the wizard (SimHub's Ok/Cancel bar is hidden). -->
        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Padding="0,14,0,0" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
            <DockPanel>
                <styles:SHButtonSecondary Style="{StaticResource DialogButtonSecondary}" DockPanel.Dock="Left" Click="Cancel_Click">
                    <StackPanel Style="{StaticResource ButtonContent}">
                        <TextBlock Text="Cancel" VerticalAlignment="Center" />
                    </StackPanel>
                </styles:SHButtonSecondary>
                <styles:SHButtonPrimary Style="{StaticResource DialogButtonPrimary}" HorizontalAlignment="Right" IsDefault="True" Click="Save_Click">
                    <StackPanel Style="{StaticResource ButtonContent}">
                        <icons:PackIconMaterial Style="{StaticResource ButtonIcon}" Kind="Check" />
                        <TextBlock Text="Save" VerticalAlignment="Center" />
                    </StackPanel>
                </styles:SHButtonPrimary>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="270" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="0,0,20,0">
                <TextBlock Style="{StaticResource Text.Title}" FontSize="19" TextWrapping="Wrap" Margin="0,0,0,4" Text="{Binding Title}" />
                <TextBlock Style="{StaticResource Text.Hint}" Margin="0,0,0,14" TextWrapping="Wrap" Text="Where the LEDs are on the picture of your dashboard." />
                <Border Margin="0,0,0,14" Padding="12,9" CornerRadius="8" Background="{StaticResource Brush.Card}">
                    <DockPanel>
                        <icons:PackIconMaterial Kind="InformationOutline" Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Top" Opacity="0.75" />
                        <TextBlock TextWrapping="Wrap" Text="{Binding Status}" />
                    </DockPanel>
                </Border>
                <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding UsePhoto}" Content="Show the LEDs on the picture" Margin="0,0,0,6" ToolTip="Off: the preview shows a generic dashboard" />
                <TextBlock Style="{StaticResource Text.Hint}" Margin="0,0,0,10" TextWrapping="Wrap"
                           Text="Drag an LED to move it. Drag the first or last LED to stretch its group." />
                <styles:SHButtonSecondary HorizontalAlignment="Left" Click="Reset_Click" IsEnabled="{Binding UsePhoto}"
                                          ToolTip="Put the LEDs back where they were found">
                    <StackPanel Style="{StaticResource ButtonContent}">
                        <icons:PackIconMaterial Style="{StaticResource ButtonIcon}" Kind="Restore" />
                        <TextBlock Text="Reset positions" VerticalAlignment="Center" />
                    </StackPanel>
                </styles:SHButtonSecondary>
            </StackPanel>
            <Border Grid.Column="1" CornerRadius="10" Padding="18" VerticalAlignment="Top" HorizontalAlignment="Left" Background="#FF141519">
                <local:PhotoLedPlacer x:Name="Placer" MaxPictureWidth="560" IsEnabled="{Binding UsePhoto}" />
            </Border>
        </Grid>
    </DockPanel>
</ui:SHDialogContentBase>
