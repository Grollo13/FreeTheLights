<ui:SHDialogContentBase x:Class="FreeTheLights.UI.DeviceWizard"
                        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:ui="clr-namespace:SimHub.Plugins.UI;assembly=SimHub.Plugins"
                        xmlns:styles="clr-namespace:SimHub.Plugins.Styles;assembly=SimHub.Plugins"
                        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                        xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
                        xmlns:local="clr-namespace:FreeTheLights.UI"
                        x:Name="Root"
                        Title="Add a device"
                        MinWidth="760" MinHeight="520">
    <ui:SHDialogContentBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FreeTheLights;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="StepTitle" TargetType="TextBlock" BasedOn="{StaticResource Text.Title}">
                <Setter Property="FontSize" Value="19" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
            <Style x:Key="StepHint" TargetType="TextBlock" BasedOn="{StaticResource Text.Hint}">
                <Setter Property="Margin" Value="0,0,0,16" />
            </Style>

            <!-- Device type card (Content = name, Ux.Icon, Ux.Description). -->
            <Style x:Key="TemplateCard" TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                <Setter Property="Width" Value="140" />
                <Setter Property="Height" Value="132" />
                <Setter Property="Margin" Value="0,0,12,12" />
                <Setter Property="GroupName" Value="Template" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Grid>
                                <Border x:Name="Bd" CornerRadius="12" Background="{StaticResource Brush.Card}" BorderBrush="{StaticResource Brush.CardBorder}" BorderThickness="1.5" Padding="10">
                                    <StackPanel VerticalAlignment="Center">
                                        <ContentControl Style="{StaticResource IconTile}" Width="46" Height="46" FontSize="26" HorizontalAlignment="Center"
                                                        local:Ux.Icon="{TemplateBinding local:Ux.Icon}" local:Ux.Accent="{DynamicResource AccentColorBrush}" />
                                        <ContentPresenter Margin="0,10,0,2" HorizontalAlignment="Center" TextElement.FontWeight="SemiBold" TextElement.FontSize="14" />
                                        <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="11" Opacity="0.6"
                                                   Text="{TemplateBinding local:Ux.Description}" />
                                    </StackPanel>
                                </Border>
                                <Grid x:Name="Tick" Width="20" Height="20" Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                                    <Ellipse Fill="{DynamicResource AccentColorBrush}" />
                                    <icons:PackIconMaterial Kind="Check" Width="11" Height="11" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Hover}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#50FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColorBrush}" />
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorBrush4}" />
                                    <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="CountLabel" TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                <Setter Property="Margin" Value="10,0,12,0" />
            </Style>
        </ResourceDictionary>
    </ui:SHDialogContentBase.Resources>

    <DockPanel Margin="4">
        <!-- Step tracker (the front plate step only exists for wheels and custom devices) -->
        <ItemsControl DockPanel.Dock="Top" Margin="0,0,0,22" ItemsSource="{Binding StepHeaders}" Focusable="False">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <Grid Width="26" Height="26">
                            <Ellipse x:Name="Circle" Stroke="#50FFFFFF" StrokeThickness="1.5" Fill="Transparent" />
                            <TextBlock x:Name="Number" Text="{Binding Number}" FontSize="12" FontWeight="SemiBold" Opacity="0.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <icons:PackIconMaterial x:Name="Done" Kind="Check" Width="12" Height="12" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Visibility="Collapsed" />
                        </Grid>
                        <TextBlock x:Name="Title" Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding Title}" Opacity="0.55" />
                        <Border x:Name="Connector" Width="28" Height="1.5" Margin="12,0,12,0" VerticalAlignment="Center" Background="#40FFFFFF" />
                    </StackPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasNext}" Value="False">
                            <Setter TargetName="Connector" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsDone}" Value="True">
                            <Setter TargetName="Circle" Property="Fill" Value="{DynamicResource AccentColorBrush}" />
                            <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentColorBrush}" />
                            <Setter TargetName="Number" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Done" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Title" Property="Opacity" Value="0.8" />
                            <Setter TargetName="Connector" Property="Background" Value="{DynamicResource AccentColorBrush}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                            <Setter TargetName="Circle" Property="Stroke" Value="{DynamicResource AccentColorBrush}" />
                            <Setter TargetName="Circle" Property="StrokeThickness" Value="2" />
                            <Setter TargetName="Number" Property="Opacity" Value="1" />
                            <Setter TargetName="Title" Property="Opacity" Value="1" />
                            <Setter TargetName="Title" Property="FontWeight" Value="SemiBold" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- The wizard's only button row (SimHub's own Ok/Cancel bar is hidden): Cancel | Back, Next / Add device -->
        <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Padding="0,14,0,0" BorderBrush="{StaticResource Brush.Divider}" BorderThickness="0,1,0,0">
            <DockPanel>
                <styles:SHButtonSecondary Style="{StaticResource DialogButtonSecondary}" DockPanel.Dock="Left" Click="Cancel_Click">
                    <StackPanel Style="{StaticResource ButtonContent}">
                        <TextBlock Text="Cancel" VerticalAlignment="Center" />
                    </StackPanel>
                </styles:SHButtonSecondary>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <styles:SHButtonSecondary Style="{StaticResource DialogButtonSecondary}" Margin="0,0,10,0" Command="{Binding BackCommand}"
                                              Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource ButtonContent}">
                            <icons:PackIconMaterial Style="{StaticResource ButtonIcon}" Kind="ChevronLeft" />
                            <TextBlock Text="Back" VerticalAlignment="Center" />
                        </StackPanel>
                    </styles:SHButtonSecondary>
                    <styles:SHButtonPrimary Style="{StaticResource DialogButtonPrimary}" Command="{Binding NextCommand}" IsDefault="True"
                                            Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                        <StackPanel Style="{StaticResource ButtonContent}">
                            <TextBlock Text="Next" VerticalAlignment="Center" />
                            <icons:PackIconMaterial Style="{StaticResource ButtonIcon}" Margin="8,0,0,0" Kind="ChevronRight" />
                        </StackPanel>
                    </styles:SHButtonPrimary>
                    <styles:SHButtonPrimary Style="{StaticResource DialogButtonPrimary}" Click="Finish_Click" IsDefault="True"
                                            Visibility="{Binding IsLastStep, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource ButtonContent}">
                            <icons:PackIconMaterial Style="{StaticResource ButtonIcon}" Kind="Check" />
                            <TextBlock Text="Add device" VerticalAlignment="Center" />
                        </StackPanel>
                    </styles:SHButtonPrimary>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <!-- ===== Step 1: device ===== -->
            <Grid Visibility="{Binding Step, Converter={StaticResource IntEquals}, ConverterParameter={x:Static local:DeviceWizardViewModel.StepDevice}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Style="{StaticResource StepTitle}" Text="Which device do you want to add?" />
                <DockPanel Grid.Row="1" Margin="0,0,0,10">
                    <TextBlock DockPanel.Dock="Right" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Hint}" FontSize="12" Text="{Binding CatalogStatus}" />
                    <Grid>
                        <TextBox x:Name="Search" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="26,0,0,0" VerticalContentAlignment="Center" MinHeight="28"
                                 ToolTip="Search by brand or name" />
                        <icons:PackIconMaterial Kind="Magnify" Width="14" Height="14" Margin="8,0,0,0" Opacity="0.6" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <TextBlock Margin="28,0,0,0" VerticalAlignment="Center" Opacity="0.45" IsHitTestVisible="False" Text="Search by brand or name, e.g. Ascher or GT4"
                                   Visibility="{Binding SearchText, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}" />
                    </Grid>
                </DockPanel>
                <ListBox Grid.Row="2" ItemsSource="{Binding ChoicesView}" SelectedItem="{Binding SelectedChoice}" ItemContainerStyle="{StaticResource DeviceListItem}"
                         Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.HeaderTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="8,10,0,4" Style="{StaticResource Text.Caption}" Text="{Binding Name}" />
                                </DataTemplate>
                            </GroupStyle.HeaderTemplate>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl Width="34" Height="34" FontSize="18" HorizontalAlignment="Left" local:Ux.Accent="{DynamicResource AccentColorBrush}"
                                                Visibility="{Binding ImageFile, Converter={StaticResource NullToVisibility}, ConverterParameter=Inverse}">
                                    <ContentControl.Style>
                                        <Style TargetType="ContentControl" BasedOn="{StaticResource IconTile}">
                                            <Setter Property="local:Ux.Icon" Value="Chip" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Template}" Value="Wheel">
                                                    <Setter Property="local:Ux.Icon" Value="Steering" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Template}" Value="Dashboard">
                                                    <Setter Property="local:Ux.Icon" Value="Speedometer" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Template}" Value="LedFlag">
                                                    <Setter Property="local:Ux.Icon" Value="Flag" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Template}" Value="LedBar">
                                                    <Setter Property="local:Ux.Icon" Value="LedStripVariant" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Template}" Value="Custom">
                                                    <Setter Property="local:Ux.Icon" Value="Tune" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ContentControl.Style>
                                </ContentControl>
                                <Image Width="56" Height="36" HorizontalAlignment="Left" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                                       Source="{Binding ImageFile, Converter={StaticResource SimHubImage}}"
                                       Visibility="{Binding ImageFile, Converter={StaticResource NullToVisibility}}" />
                                <StackPanel Grid.Column="1" Margin="4,0,8,0" VerticalAlignment="Center">
                                    <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Style="{StaticResource Text.Hint}" FontSize="11" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                </StackPanel>
                                <Border Grid.Column="2" Style="{StaticResource Badge}" Visibility="{Binding HasDisplay, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <icons:PackIconMaterial Kind="Monitor" Width="11" Height="11" Margin="0,0,5,0" VerticalAlignment="Center" />
                                        <TextBlock Text="display" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Text.Label}" Text="Name" />
                    <TextBox Width="320" FontSize="14" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" ToolTip="The name shown in FreeTheLights" />
                </StackPanel>
            </Grid>

            <!-- ===== Step 2 (SimHub devices): kind ===== -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource IntEquals}, ConverterParameter={x:Static local:DeviceWizardViewModel.StepKind}}">
                <DockPanel Margin="0,0,0,16">
                    <Image DockPanel.Dock="Left" Width="120" Height="72" Margin="0,0,16,0" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"
                           Source="{Binding Preset.ProductImageFile, Converter={StaticResource SimHubImage}}"
                           Visibility="{Binding Preset.ProductImageFile, Converter={StaticResource NullToVisibility}}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource StepTitle}" TextWrapping="Wrap" Text="{Binding KindQuestion}" />
                        <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding PresetCapabilities}" />
                    </StackPanel>
                </DockPanel>
                <ItemsControl ItemsSource="{Binding KindOptions}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <RadioButton GroupName="Kind" IsChecked="{Binding IsSelected}" Content="{Binding Title}" local:Ux.Description="{Binding Description}">
                                    <RadioButton.Style>
                                        <Style TargetType="RadioButton" BasedOn="{StaticResource TemplateCard}">
                                            <Setter Property="GroupName" Value="Kind" />
                                            <Setter Property="local:Ux.Icon" Value="Tune" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="Wheel">
                                                    <Setter Property="local:Ux.Icon" Value="Steering" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="Dashboard">
                                                    <Setter Property="local:Ux.Icon" Value="Speedometer" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="LedFlag">
                                                    <Setter Property="local:Ux.Icon" Value="Flag" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="LedBar">
                                                    <Setter Property="local:Ux.Icon" Value="LedStripVariant" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </RadioButton.Style>
                                </RadioButton>
                                <Border Margin="8,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource Badge}" Background="{DynamicResource AccentColorBrush}"
                                        Visibility="{Binding IsSuggested, Converter={StaticResource BoolToVisibility}}" IsHitTestVisible="False">
                                    <TextBlock Foreground="White" FontWeight="SemiBold" Text="Suggested" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Margin="0,6,0,0" Padding="12,9" CornerRadius="8" Background="{StaticResource Brush.Card}" HorizontalAlignment="Left">
                    <DockPanel>
                        <icons:PackIconMaterial Kind="LightbulbOnOutline" Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Top" Opacity="0.75" />
                        <TextBlock TextWrapping="Wrap" MaxWidth="640">
                            <Run Text="The suggested kind is our best guess. Pick another one if it doesn't fit." />
                        </TextBlock>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- ===== Step 3 (SimHub devices that SimHub has): the LED profile, one click ===== -->
            <Grid Visibility="{Binding Step, Converter={StaticResource IntEquals}, ConverterParameter={x:Static local:DeviceWizardViewModel.StepProfile}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource StepTitle}" Text="Connect to SimHub" />
                    <TextBlock Style="{StaticResource StepHint}" TextWrapping="Wrap"
                               Text="One click lets FreeTheLights control this device's LEDs in SimHub. Your other LED profiles stay as they are." />
                    <ItemsControl ItemsSource="{Binding Profile.Connections}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource RowCard}" Padding="12,8" Margin="0,0,0,6">
                                    <DockPanel>
                                        <Grid DockPanel.Dock="Left" Width="20" Height="20" Margin="0,0,10,0">
                                            <icons:PackIconMaterial Kind="CheckCircle" Width="18" Height="18" Foreground="{x:Static local:Theme.Ok}"
                                                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}}" />
                                            <icons:PackIconMaterial Kind="CircleOutline" Width="18" Height="18" Opacity="0.5"
                                                                    Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                                        </Grid>
                                        <TextBlock DockPanel.Dock="Right" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Hint}" FontSize="12" Text="{Binding Text}" />
                                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PartName}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <styles:SHButtonPrimary Margin="0,8,0,0" HorizontalAlignment="Left" Command="{Binding Profile.ConnectCommand}" ToolTip="Let FreeTheLights control this device in SimHub"
                                            Visibility="{Binding Profile.CanConnect, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource ButtonContent}">
                            <icons:PackIconMaterial Style="{StaticResource ButtonIcon}" Kind="LinkVariant" />
                            <TextBlock Text="Auto-setup" VerticalAlignment="Center" />
                        </StackPanel>
                    </styles:SHButtonPrimary>
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{x:Static local:Theme.Ok}" FontWeight="SemiBold"
                               Text="Connected. Your device now lights up green."
                               Visibility="{Binding Profile.IsConnected, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="{x:Static local:Theme.Warning}" Text="{Binding Profile.Message}"
                               Visibility="{Binding Profile.Message, Converter={StaticResource NullToVisibility}}" />
                    <TextBlock Margin="0,16,0,0" Style="{StaticResource Text.Hint}" TextWrapping="Wrap"
                               Text="Not now? Click Next. You can do this later on the device page."
                               Visibility="{Binding Profile.IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}" />
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.Caption}" Text="PREVIEW · GREEN ONCE CONNECTED" />
                    <Border Style="{StaticResource Stage}" MaxWidth="340" HorizontalAlignment="Left">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <local:LedPreview x:Name="ProfilePreview" />
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== Step 4: layout ===== -->
            <Grid Visibility="{Binding Step, Converter={StaticResource IntEquals}, ConverterParameter={x:Static local:DeviceWizardViewModel.StepLayout}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ScrollViewer Grid.Column="0" Margin="0,0,20,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Style="{StaticResource StepTitle}" Text="How many LEDs does it have?" />
                        <TextBlock Style="{StaticResource StepHint}" TextWrapping="Wrap"
                                   Text="Use 0 for parts your device doesn't have." />
                        <Border Margin="0,0,0,12" Padding="12,9" CornerRadius="8" Background="{StaticResource Brush.Card}"
                                Visibility="{Binding IsSimHubDevice, Converter={StaticResource BoolToVisibility}}">
                            <DockPanel>
                                <icons:PackIconMaterial Kind="InformationOutline" Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Top" Opacity="0.75" />
                                <TextBlock TextWrapping="Wrap" Text="{Binding LayoutSource}" />
                            </DockPanel>
                        </Border>
                        <Grid Visibility="{Binding ShowStripFields, Converter={StaticResource BoolToVisibility}}" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <icons:PackIconMaterial Grid.Row="0" Kind="DotsHorizontal" Width="16" Height="16" VerticalAlignment="Center" Foreground="{x:Static local:Theme.Layout}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource CountLabel}" Text="RPM LEDs (row on top)" />
                            <mah:NumericUpDown Grid.Row="0" Grid.Column="2" Width="100" Margin="0,0,0,8" Minimum="0" Maximum="512" Value="{Binding RowCount}" ToolTip="LEDs in the RPM row (0 = none)" />
                            <icons:PackIconMaterial Grid.Row="1" Kind="DotsVertical" Width="16" Height="16" VerticalAlignment="Center" Foreground="{x:Static local:Theme.Layout}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource CountLabel}" Text="Left column" />
                            <mah:NumericUpDown Grid.Row="1" Grid.Column="2" Width="100" Margin="0,0,0,8" Minimum="0" Maximum="512" Value="{Binding LeftCount}" ToolTip="LEDs in the column on the left (0 = none)" />
                            <icons:PackIconMaterial Grid.Row="2" Kind="DotsVertical" Width="16" Height="16" VerticalAlignment="Center" Foreground="{x:Static local:Theme.Layout}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource CountLabel}" Text="Right column" />
                            <mah:NumericUpDown Grid.Row="2" Grid.Column="2" Width="100" Minimum="0" Maximum="512" Value="{Binding RightCount}" ToolTip="LEDs in the column on the right (0 = none)" />
                        </Grid>
                        <StackPanel Visibility="{Binding ShowMatrixFields, Converter={StaticResource BoolToVisibility}}" Margin="0,4,0,8">
                            <CheckBox Style="{StaticResource Switch}" IsChecked="{Binding MatrixEnabled}" Content="LED matrix (flag)" FontWeight="SemiBold" ToolTip="The device has a grid of LEDs, like an LED flag" />
                            <StackPanel Margin="48,10,0,0" IsEnabled="{Binding MatrixEnabled}" Opacity="{Binding MatrixEnabled, Converter={StaticResource BoolToOpacity}}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Text.Label}" Text="Columns" />
                                    <mah:NumericUpDown Width="90" Minimum="1" Maximum="64" Value="{Binding MatrixColumns}" ToolTip="LEDs across" />
                                    <TextBlock Style="{StaticResource Text.Label}" Margin="16,0,12,0" Text="Rows" />
                                    <mah:NumericUpDown Width="90" Minimum="1" Maximum="64" Value="{Binding MatrixRows}" ToolTip="LEDs down" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <Border Style="{StaticResource Badge}" HorizontalAlignment="Left" Margin="0,6,0,0" Padding="10,4">
                            <TextBlock FontSize="12" Text="{Binding TotalLeds, StringFormat=Total: {0} LEDs}" />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                <StackPanel Grid.Column="1">
                    <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.Caption}" Text="PREVIEW · HOVER AN LED FOR ITS NUMBER" />
                    <Border Style="{StaticResource Stage}" MaxWidth="380" HorizontalAlignment="Left">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <local:LedPreview x:Name="Preview" />
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== Step 5 (SimHub dashboards): LED positions on the product picture ===== -->
            <Grid Visibility="{Binding Step, Converter={StaticResource IntEquals}, ConverterParameter={x:Static local:DeviceWizardViewModel.StepPhoto}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="300" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource StepTitle}" TextWrapping="Wrap" Text="Where are the LEDs?" />
                    <TextBlock Style="{StaticResource StepHint}" Text="Check where the LEDs are on the picture of your dashboard." />
                    <Border Margin="0,0,0,14" Padding="12,9" CornerRadius="8" Background="{StaticResource Brush.Card}">
                        <DockPanel>
                            <icons:PackIconMaterial Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Top" Opacity="0.75">
                                <icons:PackIconMaterial.Style>
                                    <Style TargetType="icons:PackIconMaterial">
                                        <Setter Property="Kind" Value="InformationOutline" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding PhotoNeedsPlacing}" Value="True">
                                                <Setter Property="Kind" Value="GestureTapHold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </icons:PackIconMaterial.Style>
                            </icons:PackIconMaterial>
                            <TextBlock TextWrapping="Wrap" Text="{Binding PhotoStatus}" />
                        </DockPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="PhotoChoice" Style="{StaticResource TemplateCard}" Width="134" Height="124" Margin="0,0,10,0"
                                     local:Ux.Icon="ImageOutline" Content="On the picture" local:Ux.Description="LEDs where they are"
                                     IsChecked="{Binding UsePhoto}" />
                        <RadioButton GroupName="PhotoChoice" Style="{StaticResource TemplateCard}" Width="134" Height="124" Margin="0"
                                     local:Ux.Icon="Speedometer" Content="Generic drawing" local:Ux.Description="a schematic dashboard"
                                     IsChecked="{Binding UseGenericDrawing}" />
                    </StackPanel>
                    <TextBlock Margin="0,14,0,8" Style="{StaticResource Text.Hint}" TextWrapping="Wrap"
                               Text="Drag an LED to move it. Drag the first or last LED to stretch its group." />
                    <styles:SHButtonSecondary HorizontalAlignment="Left" Command="{Binding ResetPhotoCommand}" IsEnabled="{Binding UsePhoto}" ToolTip="Put the LEDs back where they were found">
                        <StackPanel Style="{StaticResource ButtonContent}">
                            <icons:PackIconMaterial Style="{StaticResource ButtonIcon}" Kind="Restore" />
                            <TextBlock Text="Reset positions" VerticalAlignment="Center" />
                        </StackPanel>
                    </styles:SHButtonSecondary>
                </StackPanel>
                <Border Grid.Column="1" Style="{StaticResource Stage}" VerticalAlignment="Top" HorizontalAlignment="Left">
                    <local:PhotoLedPlacer x:Name="Placer" MaxPictureWidth="520" IsEnabled="{Binding UsePhoto}" />
                </Border>
            </Grid>

            <!-- ===== Step 6 (SimHub devices with a profile): LED wiring, checked with a test pattern on the device ===== -->
            <DockPanel Visibility="{Binding Step, Converter={StaticResource IntEquals}, ConverterParameter={x:Static local:DeviceWizardViewModel.StepWiring}}">
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource StepTitle}" Text="How are the LEDs wired?" />
                    <TextBlock Style="{StaticResource StepHint}" TextWrapping="Wrap"
                               Text="Your device now shows each group in its own color, with a white dot running along it. Change the list until the preview matches your device." />
                    <DockPanel Margin="0,0,0,12" Visibility="{Binding HasSeveralWiringParts, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource CountLabel}" Margin="0,0,10,0" VerticalAlignment="Center" Text="Part" />
                        <ComboBox Width="240" HorizontalAlignment="Left" ItemsSource="{Binding WiringParts}" SelectedItem="{Binding WiringPart}" DisplayMemberPath="Name" ToolTip="Which LEDs of the device to check" />
                    </DockPanel>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Margin="0,14,0,0" Padding="12,9" CornerRadius="8" Background="{StaticResource Brush.Card}" HorizontalAlignment="Left">
                    <DockPanel>
                        <icons:PackIconMaterial Kind="InformationOutline" Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Top" Opacity="0.7" />
                        <TextBlock TextWrapping="Wrap" MaxWidth="560"
                                   Text="Nothing lights up? Go back one step and check that the device is connected." />
                    </DockPanel>
                </Border>
                <local:WiringEditorView x:Name="WiringEditor" DataContext="{Binding Wiring}" />
            </DockPanel>

            <!-- ===== Step 7 (generic wheels and custom devices): front plate ===== -->
            <Grid Visibility="{Binding Step, Converter={StaticResource IntEquals}, ConverterParameter={x:Static local:DeviceWizardViewModel.StepFrontPlate}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource StepTitle}" Text="Buttons, lights and dials on the front plate" />
                    <TextBlock Style="{StaticResource StepHint}" Text="Pick the layout closest to your wheel. The right side mirrors the left side." />
                    <TextBlock Margin="0,0,0,6" Style="{StaticResource Text.Caption}" Text="DIALS IN THE CENTER" />
                    <ComboBox Width="320" HorizontalAlignment="Left" ItemsSource="{Binding DialPresets}" SelectedItem="{Binding SelectedDialPreset}" DisplayMemberPath="Name" ToolTip="Lit dials in the middle of the wheel" />
                    <TextBlock Margin="0,16,0,6" Style="{StaticResource Text.Caption}" Text="BUTTONS AND LIGHTS ON EACH SIDE" />
                    <ComboBox Width="320" HorizontalAlignment="Left" ItemsSource="{Binding SidePresets}" SelectedItem="{Binding SelectedSidePreset}" DisplayMemberPath="Name" ToolTip="Lit buttons on each side of the wheel" />
                    <Border Margin="0,18,0,0" Padding="12,9" CornerRadius="8" Background="{StaticResource Brush.Card}" HorizontalAlignment="Left">
                        <DockPanel>
                            <icons:PackIconMaterial Kind="InformationOutline" Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Top" Opacity="0.7" />
                            <TextBlock TextWrapping="Wrap" MaxWidth="380" Text="{Binding FrontPlateHint}" />
                        </DockPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.Caption}" Text="PREVIEW · HOVER AN ELEMENT FOR ITS NUMBER" />
                    <Border Style="{StaticResource Stage}" MaxWidth="380" HorizontalAlignment="Left">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <local:LedPreview x:Name="PlatePreview" />
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== Step 8 (buttons and dials, with SimHub's inputs): assign the inputs by pressing them ===== -->
            <Grid Visibility="{Binding Step, Converter={StaticResource IntEquals}, ConverterParameter={x:Static local:DeviceWizardViewModel.StepButtons}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                    <TextBlock Style="{StaticResource StepTitle}" Text="Press the buttons one by one" />
                    <TextBlock TextWrapping="Wrap">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource StepHint}">
                                <Setter Property="Text" Value="Press the button circled in the preview, or turn the dial, so it can light up while you press it." />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ButtonsShownOnDevice}" Value="True">
                                        <Setter Property="Text" Value="Press the button that lights up white, or turn the dial, so it can light up while you press it." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <Border Style="{StaticResource Card}" DataContext="{Binding Buttons}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Text.Caption}" Text="{Binding Progress}" Opacity="0.7" />
                            <TextBlock Margin="0,4,0,0" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding Prompt}" />
                            <TextBlock Margin="0,4,0,0" Style="{StaticResource Text.Hint}" FontSize="12" TextWrapping="Wrap"
                                       Visibility="{Binding CurrentInput, Converter={StaticResource NullToVisibility}}">
                                <Run Text="Now:" /> <Run Text="{Binding CurrentInput, Mode=OneWay}" /><Run Text=". Press another button to change it." />
                            </TextBlock>
                            <DockPanel Margin="0,10,0,0" Visibility="{Binding Note, Converter={StaticResource NullToVisibility}}">
                                <icons:PackIconMaterial Kind="CheckCircle" Width="15" Height="15" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{x:Static local:Theme.Ok}" />
                                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Note}" />
                            </DockPanel>
                            <!-- Same size: the wider of the two sets the width of both. -->
                            <UniformGrid Margin="0,14,0,0" Columns="2" HorizontalAlignment="Left">
                                <styles:SHButtonSecondary Style="{StaticResource DialogButtonSecondary}" Margin="0,0,5,0" Command="{Binding DataContext.PreviousButtonCommand, ElementName=Root}" ToolTip="Ask for the previous button again">
                                    <StackPanel Style="{StaticResource ButtonContent}">
                                        <icons:PackIconMaterial Style="{StaticResource ButtonIcon}" Kind="UndoVariant" />
                                        <TextBlock Text="Previous" VerticalAlignment="Center" />
                                    </StackPanel>
                                </styles:SHButtonSecondary>
                                <styles:SHButtonSecondary Style="{StaticResource DialogButtonSecondary}" Margin="5,0,0,0" Command="{Binding DataContext.SkipButtonCommand, ElementName=Root}" ToolTip="Go on without an input for this one">
                                    <StackPanel Style="{StaticResource ButtonContent}">
                                        <icons:PackIconMaterial Style="{StaticResource ButtonIcon}" Kind="SkipNext" />
                                        <TextBlock Text="Skip this one" VerticalAlignment="Center" />
                                    </StackPanel>
                                </styles:SHButtonSecondary>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                    <Border Margin="0,4,0,0" Padding="12,9" CornerRadius="8" Background="{StaticResource Brush.Card}" HorizontalAlignment="Left">
                        <DockPanel>
                            <icons:PackIconMaterial Kind="InformationOutline" Width="15" Height="15" Margin="0,0,10,0" VerticalAlignment="Top" Opacity="0.7" />
                            <TextBlock TextWrapping="Wrap" MaxWidth="420"
                                       Text="Click Next to skip the rest. You can change this later on the device page." />
                        </DockPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1">
                    <TextBlock Margin="0,0,0,8" Style="{StaticResource Text.Caption}" Text="PREVIEW · WHITE: PRESS NOW · GREEN: ASSIGNED" />
                    <Border Style="{StaticResource Stage}" MaxWidth="380" HorizontalAlignment="Left">
                        <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
                            <local:LedPreview x:Name="ButtonPreview" />
                        </Viewbox>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ===== Step 9: finish ===== -->
            <StackPanel Visibility="{Binding Step, Converter={StaticResource IntEquals}, ConverterParameter={x:Static local:DeviceWizardViewModel.StepFinish}}">
                <TextBlock Style="{StaticResource StepTitle}" Text="Almost done" />
                <TextBlock Style="{StaticResource StepHint}" Text="Click Add device to finish." />
                <Border Style="{StaticResource Card}">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Left" Style="{StaticResource IconTile}" VerticalAlignment="Top" local:Ux.Icon="CheckCircleOutline" local:Ux.Accent="{x:Static local:Theme.Ok}" />
                        <TextBlock Margin="14,0,0,0" TextWrapping="Wrap" LineHeight="20" Text="{Binding Summary}" />
                    </DockPanel>
                </Border>
                <!-- Set up in the wizard: SimHub already shows the device -->
                <Border Padding="12,10" CornerRadius="8" Background="{StaticResource Brush.Card}" HorizontalAlignment="Left" Margin="0,4,0,12"
                        Visibility="{Binding Profile.IsConnected, Converter={StaticResource BoolToVisibility}}">
                    <DockPanel>
                        <icons:PackIconMaterial Kind="LinkVariant" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{x:Static local:Theme.Ok}" />
                        <TextBlock TextWrapping="Wrap" MaxWidth="640"
                                   Text="Your device is connected. After adding it, use the tests on its page to check the LEDs." />
                    </DockPanel>
                </Border>
                <!-- Not (fully) set up: connect it by hand -->
                <StackPanel Visibility="{Binding Profile.IsFullyConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
                    <TextBlock Margin="0,4,0,10" Style="{StaticResource Text.Caption}" Text="THEN SET IT UP IN SIMHUB" />
                    <StackPanel>
                        <StackPanel.Resources>
                            <Style x:Key="StepNumber" TargetType="Border">
                                <Setter Property="Width" Value="22" />
                                <Setter Property="Height" Value="22" />
                                <Setter Property="CornerRadius" Value="11" />
                                <Setter Property="Margin" Value="0,0,12,0" />
                                <Setter Property="VerticalAlignment" Value="Top" />
                                <Setter Property="Background" Value="{DynamicResource AccentColorBrush}" />
                                <Setter Property="TextElement.Foreground" Value="White" />
                                <Setter Property="TextElement.FontSize" Value="11" />
                                <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                            </Style>
                        </StackPanel.Resources>
                        <DockPanel Margin="0,0,0,10">
                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">Click <Bold>Add device</Bold>.</TextBlock>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">In SimHub, open your device's LED editor (under Devices).</TextBlock>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,10">
                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">Add the <Bold>FreeTheLights</Bold> effect at the top and pick this device.</TextBlock>
                        </DockPanel>
                        <DockPanel>
                            <Border Style="{StaticResource StepNumber}"><TextBlock Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                            <TextBlock TextWrapping="Wrap" VerticalAlignment="Center">Use the tests on the device page to check the LEDs.</TextBlock>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>
    </DockPanel>
</ui:SHDialogContentBase>
