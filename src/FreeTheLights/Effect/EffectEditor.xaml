<UserControl x:Class="FreeTheLights.Effect.EffectEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:ui="clr-namespace:FreeTheLights.UI">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/FreeTheLights;component/UI/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Margin="4">
        <Border Margin="0,0,0,10" Padding="12,9" CornerRadius="8" BorderThickness="1" BorderBrush="{x:Static ui:Theme.Warning}" Background="#22FF8A3D"
                Visibility="{Binding PluginRunning, Converter={StaticResource BoolToVisibility}, ConverterParameter=Inverse}">
            <DockPanel>
                <icons:PackIconMaterial Kind="AlertOutline" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{x:Static ui:Theme.Warning}" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="The FreeTheLights plugin is not enabled. Enable it in SimHub's plugin list." />
            </DockPanel>
        </Border>
        <DockPanel Margin="0,0,0,10" Visibility="{Binding OwnerText, Converter={StaticResource NullToVisibility}}">
            <icons:PackIconMaterial Kind="PowerPlug" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" Opacity="0.7" />
            <TextBlock TextWrapping="Wrap" Text="{Binding OwnerText}" />
        </DockPanel>
        <Border Margin="0,0,0,10" Padding="12,9" CornerRadius="8" BorderThickness="1" BorderBrush="{x:Static ui:Theme.Warning}" Background="#22FF8A3D"
                Visibility="{Binding HasMismatch, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <icons:PackIconMaterial DockPanel.Dock="Left" Kind="AlertOutline" Width="16" Height="16" Margin="0,0,10,0" VerticalAlignment="Top" Foreground="{x:Static ui:Theme.Warning}" />
                <Button DockPanel.Dock="Right" Margin="10,0,0,0" Padding="10,3" VerticalAlignment="Center" Command="{Binding UseMatchingCommand}" Content="{Binding UseMatchingText}"
                        Visibility="{Binding CanUseMatching, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding MismatchWarning}" />
            </DockPanel>
        </Border>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource Text.Label}" Text="FreeTheLights device" />
            <ComboBox Grid.Row="0" Grid.Column="1" MinWidth="220" HorizontalAlignment="Left"
                      ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" ToolTip="The FreeTheLights device to show here" DisplayMemberPath="Name" />
            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,8,12,0" Style="{StaticResource Text.Label}" Text="Part"
                       Visibility="{Binding HasSeveralParts, Converter={StaticResource BoolToVisibility}}" />
            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" MinWidth="220" HorizontalAlignment="Left"
                      ItemsSource="{Binding Parts}" SelectedItem="{Binding SelectedPart}" DisplayMemberPath="Name"
                      ToolTip="Which LEDs of the device this is, e.g. RPM LEDs or buttons"
                      Visibility="{Binding HasSeveralParts, Converter={StaticResource BoolToVisibility}}" />
            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,8,12,0" Style="{StaticResource Text.Label}" Text="Matrix group"
                       Visibility="{Binding IsMatrixEffect, Converter={StaticResource BoolToVisibility}}" />
            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" MinWidth="220" HorizontalAlignment="Left"
                      ItemsSource="{Binding MatrixGroups}" SelectedItem="{Binding SelectedMatrixGroup}" ToolTip="The LED matrix to show here" DisplayMemberPath="Name"
                      Visibility="{Binding IsMatrixEffect, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
        <DockPanel Margin="0,10,0,0">
            <icons:PackIconMaterial Kind="InformationOutline" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" Opacity="0.6" />
            <TextBlock Style="{StaticResource Text.Hint}" Text="{Binding Summary}" />
        </DockPanel>
    </StackPanel>
</UserControl>
